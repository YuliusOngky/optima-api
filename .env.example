# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase JWT Secret (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Midtrans (Sandbox: https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# App
PORT=3001
